# ==========================================
# Configurações do Mautic (BJ Sports)
# ==========================================

# URL Externa do Mautic
MAUTIC_URL=https://mkt.fernandovier.com
MAUTIC_ADMIN_EMAIL=admin@bjsports.com.br
MAUTIC_ADMIN_PASSWORD=<SENHA_ADMIN_SEGURA>
MAUTIC_ADMIN_FIRSTNAME=BJ
MAUTIC_ADMIN_LASTNAME=Sports

# Configurações do Banco de Dados MySQL/MariaDB
MYSQL_ROOT_PASSWORD=<SENHA_ROOT_MYSQL>
MYSQL_DATABASE=mautic
MYSQL_USER=mauticuser
MYSQL_PASSWORD=<SENHA_BANCO_MAUTIC>
MYSQL_HOST=mautic_db
MYSQL_PORT=3306

# Configurações do Redis (Cache & Filas)
REDIS_HOST=mautic_redis
REDIS_PORT=6379
REDIS_PASSWORD=<SENHA_REDIS_OPCIONAL>

# Configurações de SMTP / Disparo de E-mails
MAUTIC_MAIL_MAILER=smtp
MAUTIC_MAIL_HOST=smtp.sendgrid.net
MAUTIC_MAIL_PORT=587
MAUTIC_MAIL_USER=apikey
MAUTIC_MAIL_PASSWORD=<SENDGRID_API_KEY>
MAUTIC_MAIL_ENCRYPTION=tls
MAUTIC_MAIL_FROM_ADDRESS=contato@bjsports.com.br
MAUTIC_MAIL_FROM_NAME="BJ Sports Marketing"

# Configuração de Backup Offsite
BACKUP_DIR=/var/backups/mautic
RCLONE_REMOTE_PATH=bjsports-backup:mautic
